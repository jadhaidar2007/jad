# Long random string. Put the same value in the TradingView alert body as "secret".
WEBHOOK_SECRET=change-me
# From @BotFather. Add the bot as an admin of your group/channel.
TELEGRAM_BOT_TOKEN=
# Group chat id(s), comma-separated (groups look like -1001234567890).
TELEGRAM_CHAT_IDS=
SIGNAL_DB_PATH=signals.db
DEDUPE_SECONDS=60

# --- Weekly report (posted to TELEGRAM_CHAT_IDS) ---
WEEKLY_REPORT=1
REPORT_WEEKDAY=4        # 0=Mon ... 4=Fri
REPORT_TIME=21:30       # UTC

# --- Paid membership via Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: only these prices unlock the group (comma-separated)
STRIPE_PRICE_IDS=
# Private group to add/remove members (defaults to the first TELEGRAM_CHAT_IDS entry)
MEMBERS_CHAT_ID=
# Any long random string; used by `python -m signalbot.setup_telegram`
TELEGRAM_WEBHOOK_SECRET=
INVITE_TTL_SECONDS=86400
