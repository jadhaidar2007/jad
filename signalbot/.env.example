# Long random string. Put the same value in the TradingView alert body as "secret".
WEBHOOK_SECRET=change-me
# From @BotFather. Add the bot as an admin of your group/channel.
TELEGRAM_BOT_TOKEN=
# Group chat id(s), comma-separated (groups look like -1001234567890).
TELEGRAM_CHAT_IDS=
SIGNAL_DB_PATH=signals.db
DEDUPE_SECONDS=60
