# --- Clip selection LLM ---
ANTHROPIC_API_KEY=
CLIP_SELECTION_MODEL=claude-sonnet-5

# --- Transcription ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Clip generation ---
MAX_CLIPS_PER_VIDEO=10
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=90
OUTPUT_ASPECT=9:16
ENABLED_PLATFORMS=youtube,tiktok,instagram

# --- YouTube Data API ---
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Instagram Graph API ---
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_APP_ID=
IG_APP_SECRET=

# --- Public storage for TikTok/IG pull-by-URL uploads ---
PUBLIC_CLIP_BASE_URL=https://your-bucket.s3.amazonaws.com
CLIPENGINE_S3_BUCKET=your-bucket
CLIPENGINE_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Infra ---
REDIS_URL=redis://redis:6379/0
CLIPENGINE_WORK_DIR=./workdir
